# Pish Hesabdari — editor consistency
# Authority: docs/PISH_HESABDARI_HOLY_BIBLE.md §11.4
# Related WBS: P0-T01
#
# UTF-8 is mandatory: the corpus contains Persian (RTL) terminology and the
# statutory seeds are UTF-8 YAML.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,mjs,json,jsonc,yaml,yml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{cfg,ini}]
indent_size = 4

[*.sql]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_size = 2

# Trimmed for readability in the seed files and the environment matrix.
[backend/.env.example]
trim_trailing_whitespace = false
