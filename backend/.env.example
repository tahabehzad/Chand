# ==========================================================================
# Pish Hesabdari — backend environment template
# Authority: docs/specs/DEPLOYMENT.md §5.1  (environment matrix), §5.2
# Related:   WBS P0-T01
#
# THIS FILE CONTAINS KEYS ONLY — NO SECRET VALUES.
# `.env` is git-ignored. This template is the committed reference of which
# variables the application reads and how they are classified.
#
# Secret-class variables are left EMPTY on purpose. Fill them from the
# local secret store or the mounted file; never paste a real value here.
# ==========================================================================

# --- application ------------------------------------------------------------
# class: public
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:5173

# --- session / cookie -------------------------------------------------------
# class: public
SESSION_COOKIE_SECURE=false

# --- database ---------------------------------------------------------------
# class: SECRET (contains a password)
DATABASE_URL=
# class: public
DB_SSL_MODE=disable

# --- object storage (ADR-002) -----------------------------------------------
# class: public
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=pish-dev
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_RETENTION_DAYS=1
# class: SECRET
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- key management (ADR-003) -----------------------------------------------
# class: SECRET
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_ROLE_ID=
# The blind-index pepper. Rotating it requires a full re-index migration
# (SPEC-AUTH-001 §8.3) — it is not a routine rotation.
BLIND_INDEX_PEPPER=
# Fallback path when Vault is unavailable (air-gapped sites).
MASTER_KEK=

# --- background processing --------------------------------------------------
# class: public
# NOTE: the job-queue implementation is UNDECIDED. ADR-005 is PROPOSED.
# These names come from the ADR-005 proposal; they are inert until the
# decision is accepted. See docs/DECISION_REQUIRED_FROM_OWNER.md (DEC-003).
OCR_WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=300

# --- statutory rule set -----------------------------------------------------
# class: public
# The engine MUST fail closed when the requested baseline is unavailable.
# 1405 is transcribed but NOT four-eyes verified and MUST NOT be activated.
# See docs/specs/STATUTORY_INGESTION.md §7.
STATUTORY_ACTIVE_YEAR=1404
STATUTORY_BOOTSTRAP_SEED_DIR=data/seeds
